{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User=${DB_USER};Password=${DB_PASS};CharSet=utf8mb4;"
  },
  "Jwt": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "Secret": "${JWT_SECRET}",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "Host": "${SMTP_HOST}",
    "Port": 587,
    "Username": "${SMTP_USER}",
    "Password": "${SMTP_PASS}",
    "FromAddress": "${SMTP_FROM}",
    "FromName": "Autohus Kvik"
  },
  "FileUpload": {
    "UploadPath": "uploads",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "GoogleMaps": {
    "ApiKey": "${GOOGLE_MAPS_API_KEY}"
  },
  "RateLimit": {
    "LoginMaxAttempts": 5,
    "LoginWindowSeconds": 300,
    "FormMaxAttempts": 10,
    "FormWindowSeconds": 60
  },
  "Synsbasen": {
    "ApiKey": "${SYNSBASEN_API_KEY}"
  }
}
